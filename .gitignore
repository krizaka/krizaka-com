# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# private doc 
**/company/**
# dependencies
**/node_modules/**
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.source/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*


# typescript
*.tsbuildinfo
next-env.d.ts
# custom
/.codegraph/
/products/
/.claude/
.CLAUDE.md

# storefront waitlist (self-hosted, local)
.data/

# local development
PLAN_DEPLOIEMENT.md
!.env.example



# The organisation's figures read from GitHub at build (scripts/gen-org-stats.mjs)
/lib/org-stats.json
# Which repositories have Discussions on, read from GitHub at build (scripts/gen-github-channels.mjs)
/lib/github-channels.json
# The published versions of the packages, read from npm and Maven Central at build (scripts/gen-registry-versions.mjs)
lib/registry-versions.json
# The products' Dev preview checklists, read from GitHub at build (scripts/gen-dev-preview.mjs)
lib/dev-preview-checklists.json

# PR captures go to Bunny Storage (scripts/pr-assets.mjs), never into the repository
docs/screenshots/
.github/pr-assets/
.github/screenshots/
lib/changelog.json
