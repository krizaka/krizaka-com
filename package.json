{
  "name": "krizaka-com",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/gen-ui-docs.mjs && node scripts/gen-org-stats.mjs && node scripts/gen-registry-versions.mjs && next dev",
    "build": "node scripts/gen-ui-docs.mjs --strict && node scripts/gen-org-stats.mjs && node scripts/gen-registry-versions.mjs && next build",
    "start": "next start",
    "lint": "eslint && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-page-templates.mjs && krizaka-i18n check messages && node scripts/gen-ui-docs.mjs --check && krizaka-ratchet && node scripts/lexicon.mjs && depcruise app lib --config .dependency-cruiser.cjs",
    "lexicon": "node scripts/lexicon.mjs",
    "ratchet": "krizaka-ratchet",
    "cdn": "node scripts/cdn-assets.mjs",
    "i18n:check": "krizaka-i18n check messages",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "docs:env": "UPDATE_DOCS=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/env.test.mjs",
    "docs:ui": "node scripts/gen-ui-docs.mjs",
    "postinstall": "fumadocs-mdx && node scripts/gen-ui-docs.mjs && node scripts/gen-registry-versions.mjs"
  },
  "dependencies": {
    "@krizaka/charts": "^0.1.0",
    "@krizaka/fonts": "^0.1.0",
    "@krizaka/i18n": "^0.1.0",
    "@krizaka/icons": "^0.4.0",
    "@krizaka/orazaka-design-system": "^3.0.0",
    "@krizaka/orochia-design-system": "^4.1.0",
    "@krizaka/query": "^0.1.1",
    "@krizaka/tailwind": "^3.4.0",
    "@krizaka/tokens": "^3.1.0",
    "@krizaka/ui": "^3.4.0",
    "@types/mdx": "^2.0.14",
    "framer-motion": "^12.40.0",
    "fumadocs-core": "^16.17.1",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "maplibre-gl": "^6.14.0",
    "next": "^16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@krizaka/config": "^0.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@krizaka/ui": "$@krizaka/ui",
    "@krizaka/tokens": "$@krizaka/tokens",
    "@krizaka/tailwind": "$@krizaka/tailwind"
  }
}
