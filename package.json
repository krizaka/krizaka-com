{
  "name": "krizaka-com",
  "version": "0.15.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "check:a11y": "node scripts/check-a11y.mjs",
    "dev": "node scripts/gen-org-stats.mjs && node scripts/gen-github-channels.mjs && node scripts/gen-registry-versions.mjs && node scripts/gen-dev-versions.mjs && node scripts/gen-changelog.mjs && next dev",
    "build": "node scripts/gen-org-stats.mjs && node scripts/gen-github-channels.mjs && node scripts/gen-registry-versions.mjs && node scripts/gen-dev-versions.mjs && node scripts/gen-changelog.mjs && node scripts/gen-dev-preview.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sign-services.mjs --check && next build && krizaka-code-names .next/server/app && node scripts/check-changelog-build.mjs",
    "start": "next start",
    "lint": "eslint && krizaka-server-client-boundary && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-page-templates.mjs && krizaka-i18n check messages && krizaka-code-names messages content && krizaka-ratchet && depcruise app lib --config .dependency-cruiser.cjs && ast-grep test --skip-snapshot-tests && krizaka-sg-ratchet && npm run format:check",
    "services:sign": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sign-services.mjs",
    "services:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sign-services.mjs --check",
    "ratchet": "krizaka-ratchet",
    "cdn": "node scripts/cdn-assets.mjs",
    "i18n:check": "krizaka-i18n check messages",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:coverage": "mkdir -p coverage && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "docs:env": "UPDATE_DOCS=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/env.test.mjs",
    "postinstall": "node scripts/gen-fresh.mjs",
    "changelog:draft": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/changelog-draft.mjs",
    "dev:check": "node scripts/dev-check.mjs",
    "lint:sg": "krizaka-sg-ratchet",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "krizaka-sg-ratchet --update",
    "sg:fix": "node scripts/sg-fix.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\""
  },
  "dependencies": {
    "@krizaka/charts": "^0.8.0",
    "@krizaka/discovery": "^0.1.0",
    "@krizaka/email-verification": "^0.1.0",
    "@krizaka/fonts": "^0.5.3",
    "@krizaka/i18n": "^0.2.3",
    "@krizaka/icons": "^0.9.0",
    "@krizaka/org": "^0.7.0",
    "@krizaka/query": "^0.3.0",
    "@krizaka/rate-limit": "^0.2.0",
    "@krizaka/tailwind": "^3.80.0",
    "@krizaka/tokens": "^3.80.0",
    "@krizaka/ui": "^3.80.0",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/a11y-audit": "0.2.0",
    "@krizaka/config": "^0.17.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "path-to-regexp": "6.3.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@krizaka/ui": "$@krizaka/ui",
    "@krizaka/tokens": "$@krizaka/tokens",
    "@krizaka/tailwind": "$@krizaka/tailwind"
  }
}
