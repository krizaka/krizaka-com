  "private": true,
  "scripts": {
    "dev": "node scripts/gen-ui-docs.mjs && next dev",
    "build": "node scripts/gen-ui-docs.mjs --strict && next build",
    "start": "next start",
    "lint": "eslint && krizaka-i18n check messages && node scripts/gen-ui-docs.mjs --check",
    "i18n:check": "krizaka-i18n check messages",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "docs:ui": "node scripts/gen-ui-docs.mjs",
    "postinstall": "fumadocs-mdx && node scripts/gen-ui-docs.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@krizaka/i18n": "^0.1.0-beta.2",
    "@krizaka/tailwind": "^2.0.0-beta.6",
    "@krizaka/tokens": "^2.0.0-beta.6",
    "@krizaka/ui": "^2.0.0-beta.6",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "@types/mdx": "^2.0.14",
    "@xyflow/react": "^12.11.0",
    "dagre": "^0.8.5",
    "framer-motion": "^12.40.0",
    "fumadocs-core": "^16.17.1",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "next": "^16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
