{
  "name": "krizaka-com",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/gen-org-stats.mjs && node scripts/gen-registry-versions.mjs && node scripts/gen-changelog.mjs && next dev",
    "build": "node scripts/gen-org-stats.mjs && node scripts/gen-registry-versions.mjs && node scripts/gen-changelog.mjs && node scripts/gen-dev-preview.mjs && next build && node scripts/check-changelog-build.mjs",
    "start": "next start",
    "lint": "eslint && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-page-templates.mjs && krizaka-i18n check messages && krizaka-ratchet && node scripts/lexicon.mjs && depcruise app lib --config .dependency-cruiser.cjs && ast-grep test --skip-snapshot-tests && node scripts/sg-ratchet.mjs",
    "lexicon": "node scripts/lexicon.mjs",
    "ratchet": "krizaka-ratchet",
    "cdn": "node scripts/cdn-assets.mjs",
    "i18n:check": "krizaka-i18n check messages",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "docs:env": "UPDATE_DOCS=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/env.test.mjs",
    "postinstall": "node scripts/gen-registry-versions.mjs && node scripts/gen-changelog.mjs",
    "changelog:draft": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/changelog-draft.mjs",
    "lint:sg": "node scripts/sg-ratchet.mjs",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "node scripts/sg-ratchet.mjs --update",
    "sg:fix": "node scripts/sg-fix.mjs"
  },
  "dependencies": {
    "@krizaka/charts": "^0.6.0",
    "@krizaka/fonts": "^0.3.0",
    "@krizaka/i18n": "^0.2.2",
    "@krizaka/icons": "^0.7.0",
    "@krizaka/query": "^0.2.0",
    "@krizaka/tailwind": "^3.40.0",
    "@krizaka/tokens": "^3.40.0",
    "@krizaka/ui": "^3.40.0",
    "next": "^16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/config": "^0.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "path-to-regexp": "6.3.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@krizaka/ui": "$@krizaka/ui",
    "@krizaka/tokens": "$@krizaka/tokens",
    "@krizaka/tailwind": "$@krizaka/tailwind"
  }
}
