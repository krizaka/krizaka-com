{
  "globs": ["app/**/*.tsx", "components/**/*.tsx", "src/**/*.tsx"],
  "stackGlobs": [
    "app/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "components/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "src/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "lib/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "hooks/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "features/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "scripts/**/*.{js,jsx,mjs,ts,tsx,mts}"
  ],
  "retire": [],
  "counters": {
    "palette": 0,
    "light": 0,
    "arbitraryVar": 0,
    "classNameTemplate": 0,
    "fetchInClientEffect": 0,
    "asyncInEffect": 0,
    "derivedStateInEffect": 0,
    "directTanstackImport": 0,
    "localTableOrForm": 2,
    "retiredImport": 0,
    "routeStateSelection": 0,
    "cognitiveComplexity": 7,
    "sonar": 65,
    "codeRules": 475,
    "code/curly": 426,
    "sonarjs/no-nested-template-literals": 23,
    "code/max-depth": 42,
    "sonarjs/super-linear-regex": 18,
    "sonarjs/no-nested-conditional": 17,
    "sonarjs/no-os-command-from-path": 3,
    "sonarjs/no-inverted-boolean-check": 1,
    "code/max-nested-callbacks": 1,
    "sonarjs/concise-regex": 1,
    "sonarjs/void-use": 1,
    "code/no-console": 6,
    "sonarjs/redundant-type-aliases": 1
  }
}
