# Contact form delivery (lib/contact.ts) — copy to .env.local and fill in. Never commit real keys.

# Mailgun (https://documentation.mailgun.com) — private API key, Basic auth `api:<key>`
MAILGUN_API_KEY=
# Sending domain verified in Mailgun
MAILGUN_DOMAIN=mg.krizaka.com
# US region by default; use https://api.eu.mailgun.net for an EU-region domain
MAILGUN_API_URL=https://api.mailgun.net

# Recipient(s) of the contact messages, comma-separated
CONTACT_TO_EMAIL=
# Optional sender (must be on MAILGUN_DOMAIN); default: Krizaka <contact@MAILGUN_DOMAIN>
CONTACT_FROM_EMAIL=Krizaka <contact@mg.krizaka.com>

# Optional second channel: Slack / Discord / any JSON relay
CONTACT_WEBHOOK_URL=
