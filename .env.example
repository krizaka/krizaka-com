# Where the running product demo is (Orochia today): every "open the app" link, the structured data and llms.txt point here.
# Read at build time — change it in the host (Vercel settings, or the App Platform spec) and redeploy to switch.
NEXT_PUBLIC_APP_DEMO_URL=https://dev.orochia.com

# Where the media (tours, gallery, home backdrop) are served from — Bunny, under site/ (lib/cdn.ts, scripts/cdn-assets.mjs).
# Read at build time; empty = https://krizaka-assets.b-cdn.net.
NEXT_PUBLIC_MEDIA_CDN_URL=

# Contact form delivery (lib/contact.ts) — copy to .env.local and fill in. Never commit real keys.

# The provider (mailgun — https://documentation.mailgun.com) and its private API key, Basic auth `api:<key>`
MAIL_PROVIDER=mailgun
MAIL_API_KEY=
# Sending domain verified in Mailgun
MAIL_DOMAIN=mg.krizaka.com
# US region by default; use https://api.eu.mailgun.net for an EU-region domain
MAIL_API_URL=https://api.mailgun.net

# Recipient(s) of the contact messages, comma-separated
MAIL_CONTACT_TO=
# Optional sender (must be on MAIL_DOMAIN); default: Krizaka <contact@MAIL_DOMAIN>
MAIL_FROM=Krizaka <contact@mg.krizaka.com>

# Optional second channel: Slack / Discord / any JSON relay
MAIL_CONTACT_WEBHOOK_URL=

# PR captures (scripts/pr-assets.mjs, local tooling only — never needed by the site)
# MEDIA_STORAGE_API_KEY=
# MEDIA_STORAGE_ZONE=
# MEDIA_STORAGE_ENDPOINT=storage.bunnycdn.com
# MEDIA_CDN_HOSTNAME=
